# Chaves de API para os provedores de IA
# Renomeie este arquivo para .env e preencha as chaves que for usar.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Arquivo de cookies (formato Netscape) de uma sessão logada — necessário
# para baixar do Instagram. Se omitido, usa ./cookies.txt quando existir.
# ATENÇÃO: esse arquivo dá acesso à sua conta. Nunca o versione.
# COOKIES_FILE=cookies.txt
